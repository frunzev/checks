#!/bin/sh
set -e
. "$toolkit/tools.sh"

default_maximum_lines=$(setting checks.file-length.max-lines)
language_maximum_lines=$(setting checks.file-length.max-lines-by-language)
language_limits_summary=$(printf '%s' "$language_maximum_lines" \
    | sed 's/^/, /; s/ = / /' | tr -d '\n')
line_limits="max $default_maximum_lines lines$language_limits_summary"

echo "checks: file length ($line_limits)"
echo "checks: follow SRP - split a file that grew past one job"

maximum_lines_of() {
    configured_maximum=$(printf '%s\n' "$language_maximum_lines" \
        | sed -n "s/^$1 = //p")

    echo "${configured_maximum:-$default_maximum_lines}"
}

overlong_files_among() {
    maximum_lines=$1

    without_whitelisted | grep -a . | while IFS= read -r source_file; do
        line_count=$(awk 'END {print NR}' < "$source_file")

        if [ "$line_count" -gt "$maximum_lines" ]; then
            printf '%s (%s lines)\n' "$source_file" "$line_count"
        fi
    done
}

overlong_files=$(for language in $supported_languages; do
    "${language}_files_in" "$@" \
        | overlong_files_among "$(maximum_lines_of "$language")"
done | within_scope)

fail_on_findings "$overlong_files" "over the line limit of their language:"
