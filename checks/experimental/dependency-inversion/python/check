#!/bin/sh
set -e
. "$toolkit/tools.sh"

echo "checks: dependency inversion in python (depend on abstractions)"

findings=$(python_files_in "$@" \
    | "$toolkit_python" \
    "$(dirname "$0")/constructed_collaborators.py")
constructions=$(printf '%s\n' "$findings" | reportable_findings)

fail_on_findings "$constructions" \
    "these dependency inversion risks were detected:" \
    "follow DIP - receive the collaborator as an injected abstraction" \
    "instead of constructing it"
